# The exit status is sweep's contract with CI:
# 0 every target is up, 1 some are down, 2 usage or input error.

# Every target up: exit 0, the table on stdout, the summary on stderr.
envsubst healthy.txt
exits 0 sweep healthy.txt
stdout '^UP +http://127\.0\.0\.1:\d+/ok +\S+ +1 +200 OK$'
stdout -count=2 '^UP '
stderr '^checked 2/2 targets in \S+: 2 up, 0 down$'

# Two targets down: exit 1. The table shows why, and the TRIES column
# shows the retry policy at work: 502 and 503 are retried, 404 is not.
envsubst mixed.txt
exits 1 sweep mixed.txt
stdout '^UP +\S+/flaky +\S+ +3 +200 OK$'
stdout '^DOWN +\S+/down +\S+ +3 +unhealthy status 503'
stdout '^DOWN +\S+/missing +\S+ +1 +unhealthy status 404'
stderr '2 up, 2 down$'

# Usage errors: exit 2 and nothing on stdout, so a pipeline never
# mistakes an error message for results.
exits 2 sweep -o yaml healthy.txt
stderr 'unknown output format "yaml"'
! stdout .
exits 2 sweep -c 0 healthy.txt
stderr 'concurrency must be >= 1, got 0'

-- healthy.txt --
# staging, healthy
$FLEET/ok
tcp://$FLEET_ADDR
-- mixed.txt --
$FLEET/ok
$FLEET/flaky
$FLEET/down
$FLEET/missing
